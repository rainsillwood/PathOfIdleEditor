<Window x:Class="PathOfIdleEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Path of Idle 独立编辑器" Height="720" Width="960"
        MinHeight="720" MinWidth="960" WindowStartupLocation="CenterScreen" Icon="IconGroup103.ico"
        Background="#0B1120" Foreground="#E5E7EB" FontFamily="Microsoft YaHei UI">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#111827" />
    <SolidColorBrush x:Key="Panel2Brush" Color="#172033" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2B3851" />
    <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8" />
    <!-- TextBlock 保持继承父控件的 Foreground，避免下拉框浅色背景中仍被强制显示为白色。 -->
    <Style TargetType="Label">
      <Setter Property="Foreground" Value="#CBD5E1" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0F172A" />
      <Setter Property="Foreground" Value="#F8FAFC" />
      <Setter Property="CaretBrush" Value="#F8FAFC" />
      <Setter Property="SelectionBrush" Value="#2563EB" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Margin" Value="2" />
    </Style>
    <Style TargetType="ComboBox">
      <!-- 系统 ComboBox 模板在部分 Windows 主题下固定使用浅色输入区域，因此采用深色文字保证对比度。 -->
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Margin" Value="2" />
    </Style>
    <Style TargetType="ComboBoxItem">
      <!-- 自定义选项模板，避免 Windows 系统主题用浅色高亮背景覆盖应用配色。 -->
      <Setter Property="Background" Value="#0F172A" />
      <Setter Property="Foreground" Value="#E5E7EB" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" SnapsToDevicePixels="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#1E40AF" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Trigger>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#1D4ED8" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#075985" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ItemBorder" Property="Background" Value="#111827" />
                <Setter Property="Foreground" Value="#64748B" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#CBD5E1" />
      <Setter Property="Padding" Value="20,5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="HeaderBorder" Background="#172033" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HeaderBorder" Property="Background" Value="#23314A" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="HeaderBorder" Property="Background" Value="#1D4ED8" />
                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="#60A5FA" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#64748B" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#1D4ED8" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#0F172A" />
      <Setter Property="Foreground" Value="#E5E7EB" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="#25324A" />
      <Setter Property="RowBackground" Value="#0F172A" />
      <Setter Property="AlternatingRowBackground" Value="#141E31" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#1E293B" />
      <Setter Property="Foreground" Value="#E2E8F0" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Foreground" Value="#E5E7EB" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#1D4ED8" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="5,5" />
      <Setter Property="Margin" Value="0,1" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="5">
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Background="#14213A">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Path of Idle 独立编辑器" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Text="规则实时读取自当前游戏；修改通过无界面 BepInEx 桥接写入存档。" Foreground="#94A3B8"/>
        </StackPanel>
        <Button Grid.Column="1" x:Name="RefreshButton" Content="连接 / 刷新游戏数据" Click="RefreshButton_Click" MinWidth="170" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#111827" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="5">
      <StackPanel Orientation="Horizontal">
        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#64748B" Margin="0,0,9,0" />
        <TextBlock x:Name="StatusText" Text="请启动游戏并进入一个游戏存档，然后连接。" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <TabControl Background="Transparent" BorderThickness="0">
      <TabItem Header="装备生成器">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TabControl x:Name="EquipmentModeTabs" Grid.Row="0" Background="Transparent" BorderThickness="0" SelectionChanged="EquipmentModeTabs_SelectionChanged">
            <TabItem Header="生成器" IsSelected="True" />
            <TabItem Header="编辑器" />
          </TabControl>
          <Grid Grid.Row="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Card}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="210" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.ColumnSpan="3" Text="基础规则" FontSize="18" FontWeight="SemiBold" Margin="4,0,4,10" />
                <Label Grid.Row="1" Content="搜索装备名称或 ID" />
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="EquipmentSearchText" TextChanged="EquipmentSearchText_TextChanged" />
                <Label Grid.Row="2" x:Name="EquipmentTemplateLabel" Content="装备模板" />
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="EquipmentTemplateCombo" DisplayMemberPath="Display" SelectionChanged="EquipmentSelectionChanged" />
                <Button Grid.Row="2" Grid.Column="2" x:Name="RefreshEquipmentListButton" Content="刷新装备列表" Click="RefreshEquipmentListButton_Click" Visibility="Collapsed" />
                <!-- 品级与装备质量合并到同一行：左侧 = 该装备支持的品级，右侧 = 装备质量（mainAttrGrade）。 -->
                <Label Grid.Row="3" Content="品级" />
                <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <ComboBox x:Name="QualityCombo" DisplayMemberPath="Display" SelectionChanged="EquipmentSelectionChanged" />
                  <TextBlock Grid.Column="1" Text="装备质量" VerticalAlignment="Center" Foreground="#94A3B8" Margin="12,0,8,0" />
                  <ComboBox Grid.Column="2" x:Name="EquipmentGradeCombo" DisplayMemberPath="Display" SelectionChanged="EquipmentSelectionChanged" />
                </Grid>
                <!-- 需求 3：合法装备等级 = 输入框 + 滑块，滑块左右显示上下界。 -->
                <Label Grid.Row="4" Content="装备等级" />
                <DockPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" LastChildFill="True">
                  <TextBox x:Name="EquipmentLevelText" DockPanel.Dock="Left" Width="70"
                             TextChanged="EquipmentRangeInput_TextChanged" LostFocus="EquipmentRangeInput_LostFocus"
                             KeyDown="EquipmentRangeInput_KeyDown" />
                  <TextBlock x:Name="EquipmentLevelMinText" DockPanel.Dock="Left" VerticalAlignment="Center" MinWidth="34"
                               TextAlignment="Right" Foreground="#94A3B8" Margin="0,0,6,0" />
                  <TextBlock x:Name="EquipmentLevelMaxText" DockPanel.Dock="Right" VerticalAlignment="Center" MinWidth="34"
                               Foreground="#94A3B8" Margin="6,0,0,0" />
                  <Slider x:Name="EquipmentLevelSlider" Minimum="0" Maximum="0" IsSnapToTickEnabled="True" TickFrequency="1"
                            SmallChange="1" LargeChange="1" VerticalAlignment="Center"
                            ValueChanged="EquipmentLevelSlider_ValueChanged"
                            PreviewMouseWheel="EquipmentRangeSlider_PreviewMouseWheel" />
                </DockPanel>
                <!-- 需求 3：锻造等级同上，范围来自当前装备等级的 TEquipForge 规则。 -->
                <Label Grid.Row="5" Content="锻造等级" />
                <DockPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" LastChildFill="True">
                  <TextBox x:Name="EquipmentForgeLevelText" DockPanel.Dock="Left" Width="70"
                             TextChanged="EquipmentRangeInput_TextChanged" LostFocus="EquipmentRangeInput_LostFocus"
                             KeyDown="EquipmentRangeInput_KeyDown" />
                  <TextBlock x:Name="EquipmentForgeLevelMinText" DockPanel.Dock="Left" VerticalAlignment="Center" MinWidth="34"
                               TextAlignment="Right" Foreground="#94A3B8" Margin="0,0,6,0" />
                  <TextBlock x:Name="EquipmentForgeLevelMaxText" DockPanel.Dock="Right" VerticalAlignment="Center" MinWidth="34"
                               Foreground="#94A3B8" Margin="6,0,0,0" />
                  <Slider x:Name="EquipmentForgeLevelSlider" Minimum="0" Maximum="0" IsSnapToTickEnabled="True" TickFrequency="1"
                            SmallChange="1" LargeChange="1" VerticalAlignment="Center"
                            ValueChanged="EquipmentForgeLevelSlider_ValueChanged"
                            PreviewMouseWheel="EquipmentRangeSlider_PreviewMouseWheel" />
                </DockPanel>
                <!-- 镶嵌（开孔）信息已合并到下方「词条编辑」的信息栏里（AffixRuleText），
                       这里不再单独占一行。实际开孔在词条表格的「镶嵌」组里逐行填写。 -->
              </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}">
              <Grid Cursor="Hand">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.ColumnSpan="2">
                  <TextBlock Text="词条编辑" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock x:Name="AffixRuleText" Text="选择装备、品级和等级后读取游戏词条池。"
                               Foreground="#94A3B8" Margin="0,5" TextWrapping="Wrap" />
                </StackPanel>
                <Grid Grid.Row="1" Grid.ColumnSpan="2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <CheckBox Grid.Column="0" x:Name="OverrideLimitsCheck" Content="越界" VerticalAlignment="Center"
                              Foreground="#F87171"
                              ToolTip="勾选后，添加词条/孔位时无视数量上限；表格内每行的「强制越界」仍然只作用于该行。" />
                  <Button Grid.Column="1" Content="添加" Click="AddAffixButton_Click" Padding="16,5,16,5"/>
                  <ComboBox Grid.Column="2" x:Name="AffixQualityCombo" DisplayMemberPath="Display" SelectionChanged="AffixQualityCombo_SelectionChanged" Grid.ColumnSpan="2" />
                  <Label Grid.Column="3" ></Label>
                  <ComboBox Grid.Column="4" x:Name="AllowedAffixCombo" DisplayMemberPath="Display"/>
                </Grid>
                <DataGrid Grid.Row="2" Grid.ColumnSpan="2" x:Name="AffixesGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                            EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                            VirtualizingPanel.IsVirtualizingWhenGrouping="True" RowHeight="38" ColumnHeaderHeight="20" FontSize="14"
                            BeginningEdit="AffixesGrid_BeginningEdit"
                            CellEditEnding="AffixesGrid_CellEditEnding">
                  <DataGrid.GroupStyle>
                    <GroupStyle>
                      <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                          <Border BorderBrush="#475569" BorderThickness="0,1,0,1" Padding="10,6" Margin="0,6,0,2">
                            <Border.Style>
                              <Style TargetType="Border">
                                <!-- 普通与未知档位：中性灰兜底。 -->
                                <Setter Property="Background" Value="#293241" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Items[0].GroupStyleKey}" Value="精良">
                                    <Setter Property="Background" Value="#17375E" />
                                    <Setter Property="BorderBrush" Value="#2563EB" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Items[0].GroupStyleKey}" Value="稀有">
                                    <Setter Property="Background" Value="#493A16" />
                                    <Setter Property="BorderBrush" Value="#D97706" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Items[0].GroupStyleKey}" Value="传说">
                                    <!-- 传说 = 橙色（与稀有的琥珀、神话的红色区分开）。 -->
                                    <Setter Property="Background" Value="#4A2A14" />
                                    <Setter Property="BorderBrush" Value="#EA580C" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Items[0].GroupStyleKey}" Value="神话">
                                    <!-- 神话 = 游戏里的红色。 -->
                                    <Setter Property="Background" Value="#4A1D22" />
                                    <Setter Property="BorderBrush" Value="#B32832" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Items[0].GroupStyleKey}" Value="污染">
                                    <!-- 污染 = 紫色（与行内紫字呼应）。 -->
                                    <Setter Property="Background" Value="#331A4D" />
                                    <Setter Property="BorderBrush" Value="#A855F7" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Items[0].GroupStyleKey}" Value="镶嵌">
                                    <!-- 镶嵌 = 品红色系（深品红底 + 品红边框，与污染的紫色系区分开）。 -->
                                    <Setter Property="Background" Value="#4A0E2E" />
                                    <Setter Property="BorderBrush" Value="#EC4899" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="#CBD5E1" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items[0].GroupStyleKey}" Value="精良">
                                      <Setter Property="Foreground" Value="#60A5FA" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Items[0].GroupStyleKey}" Value="稀有">
                                      <Setter Property="Foreground" Value="#FBBF24" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Items[0].GroupStyleKey}" Value="传说">
                                      <Setter Property="Foreground" Value="#FB923C" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Items[0].GroupStyleKey}" Value="神话">
                                      <Setter Property="Foreground" Value="#F87171" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Items[0].GroupStyleKey}" Value="污染">
                                      <Setter Property="Foreground" Value="#C084FC" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Items[0].GroupStyleKey}" Value="镶嵌">
                                      <Setter Property="Foreground" Value="#F9A8D4" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </Border>
                        </DataTemplate>
                      </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                  </DataGrid.GroupStyle>
                  <DataGrid.Columns>
                    <!-- 行内删除：表格上方的「删除选中」已弃用。 -->
                    <DataGridTemplateColumn Header="" Width="Auto" MinWidth="70">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Button Content="删除" Padding="8,0" Height="26" Margin="2,0"
                                    Background="#7F1D1D" Click="RemoveAffixRow_Click"
                                    IsEnabled="{Binding CanRemove}"
                                    ToolTip="传说/神话/独有档位与装备自带的基础词条不允许删除。" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="词条 ID" Binding="{Binding Id}" IsReadOnly="True" Width="Auto" MinWidth="90" />
                    <DataGridTextColumn Header="词条描述" Binding="{Binding DescriptionText}" IsReadOnly="True" Width="Auto" MinWidth="260" MaxWidth="900" />
                    <DataGridTextColumn Header="类别" Binding="{Binding CategoryText}" IsReadOnly="True" Width="Auto" MinWidth="110" />
                    <!-- 用普通 DataGridTextColumn + UpdateSourceTrigger=LostFocus：
                           F2 / 退格 / Del / 直接输入覆盖 这些标准编辑手势由 DataGrid 原生提供，
                           而修正（取整、夹紧、越界、留空）天然发生在提交（离开单元格/回车）时。 -->
                    <DataGridTextColumn Header="等级" Binding="{Binding LevelText, UpdateSourceTrigger=LostFocus}" Width="Auto" MinWidth="120" />
                    <!-- 需求 2.2：档位相关 → 低;中;高；随机 → 下界~上界；固定 → 只显示该值。 -->
                    <DataGridTextColumn Header="参考数值（不校验）" Binding="{Binding ReferenceText}" IsReadOnly="True" Width="Auto" MinWidth="190" />
                    <DataGridTextColumn Header="数值" Binding="{Binding ValueText, UpdateSourceTrigger=LostFocus}" Width="Auto" MinWidth="130" />
                    <!-- 需求 2.3：勾选后把数值写入存档并用哨兵使其生效；未勾选则清除哨兵。 -->
                    <DataGridCheckBoxColumn Header="强制越界" Binding="{Binding ForceOverflow, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="90" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </Border>
          </Grid>
          <Button Grid.Row="2" x:Name="EquipmentActionButton" Content="生成装备并加入背包" Click="EquipmentActionButton_Click" Height="36" FontSize="16" />
        </Grid>
      </TabItem>

      <TabItem Header="物品编辑器">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <!-- 类型标签同时过滤新增候选和当前背包，避免不同物品规则混在一起。 -->
          <TabControl x:Name="InventoryTypeTabs" Background="Transparent" BorderThickness="0"
                      SelectionChanged="InventoryTypeTabs_SelectionChanged">
            <TabItem Header="资源" Tag="1" IsSelected="True" />
            <TabItem Header="工具 / 宝箱" Tag="10" />
            <TabItem Header="符文" Tag="3" />
            <TabItem Header="奇物" Tag="5" />
          </TabControl>
          <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid Cursor="Hand">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="163.5" />
                <ColumnDefinition Width="6.5"/>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="140" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Grid.ColumnSpan="5" Text="增加物品到背包" FontSize="18" FontWeight="SemiBold" Margin="4,0,4,10" />
              <Label Grid.Row="1" Content="搜索名称或 ID" Grid.ColumnSpan="2" />
              <TextBox Grid.Row="1" Grid.Column="2" x:Name="InventoryTemplateSearchText" TextChanged="InventoryTemplateSearchText_TextChanged"/>
              <Button Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Content="增加选中物品到背包" Click="AddInventoryButton_Click" Padding="14,5"/>
              <Label Grid.Row="2" Content="物品" Grid.ColumnSpan="2" />
              <ComboBox Grid.Row="2" Grid.Column="2" x:Name="InventoryTemplateCombo" DisplayMemberPath="Display"/>
              <Label Grid.Row="2" Grid.Column="3" Content="增加数量" />
              <TextBox Grid.Row="2" Grid.Column="4" x:Name="AddInventoryCountText" Text="1"/>
            </Grid>
          </Border>
          <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid Margin="4,0,4,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="当前背包物品" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" x:Name="InventorySearchText" TextChanged="InventorySearchText_TextChanged"
                     ToolTip="搜索名称、ID 或类别" Margin="18,0,4,0" />
              </Grid>
              <DataGrid Grid.Row="1" x:Name="InventoryGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended"
                    EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                    RowHeight="38" ColumnHeaderHeight="40">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="存放位置" Binding="{Binding ContainerName}" IsReadOnly="True" Width="115" />
                  <DataGridTextColumn Header="槽位" Binding="{Binding FieldIndex}" IsReadOnly="True" Width="75" />
                  <DataGridTextColumn Header="类别" Binding="{Binding TypeName}" IsReadOnly="True" Width="90" />
                  <DataGridTextColumn Header="物品 ID" Binding="{Binding Id}" IsReadOnly="True" Width="100" />
                  <DataGridTextColumn Header="名称" Binding="{Binding Name}" IsReadOnly="True" Width="*" MinWidth="220" />
                  <DataGridTextColumn Header="品质" Binding="{Binding Quality}" IsReadOnly="True" Width="80" />
                  <DataGridTextColumn Header="等级" Binding="{Binding Level}" IsReadOnly="True" Width="80" />
                  <DataGridTextColumn Header="数量（可编辑）" Binding="{Binding CountText, UpdateSourceTrigger=LostFocus}" Width="140" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
          <Button Grid.Row="3" Content="应用表格中修改的数量（可一次改多行，0 = 删除）" Click="ApplyInventoryCountButton_Click" Height="36" FontSize="16" />
        </Grid>
      </TabItem>

      <TabItem Header="崇拜者">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Label Content="崇拜者等级" />
              <TextBox Grid.Column="1" x:Name="LordLevelText" />
              <TextBlock Grid.Column="2" x:Name="LordLevelRuleText" Foreground="#94A3B8" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
            </Grid>
          </Border>
          <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <StackPanel Margin="4,0,4,8">
                <TextBlock Text="属性加成" FontSize="18" FontWeight="SemiBold" />
              </StackPanel>
              <DataGrid Grid.Row="1" x:Name="LordJobsGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                    SelectionChanged="LordJobsGrid_SelectionChanged"
                    CellEditEnding="LordJobsGrid_CellEditEnding"
                    EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="职业 ID" Binding="{Binding JobId}" IsReadOnly="True" Width="80" />
                  <DataGridTextColumn Header="职业魔偶" Binding="{Binding JobName}" IsReadOnly="True" Width="*" MinWidth="150" />
                  <DataGridTextColumn Header="等级" Binding="{Binding Level, UpdateSourceTrigger=PropertyChanged}" Width="85" />
                  <DataGridTextColumn Header="等级上限" Binding="{Binding MaximumLevel}" IsReadOnly="True" Width="90" />
                  <DataGridTextColumn Header="崇拜者要求" Binding="{Binding RequiredLordLevel}" IsReadOnly="True" Width="105" />
                  <DataGridTextColumn Header="累计属性总点" Binding="{Binding TotalAttributePoints}" IsReadOnly="True" Width="110" />
                  <DataGridTextColumn Header="力量总加成" Binding="{Binding Strength, UpdateSourceTrigger=PropertyChanged}" Width="105" />
                  <DataGridTextColumn Header="力量累计范围" Binding="{Binding StrengthRange}" IsReadOnly="True" Width="105" />
                  <DataGridTextColumn Header="敏捷总加成" Binding="{Binding Dexterity, UpdateSourceTrigger=PropertyChanged}" Width="105" />
                  <DataGridTextColumn Header="敏捷累计范围" Binding="{Binding DexterityRange}" IsReadOnly="True" Width="105" />
                  <DataGridTextColumn Header="智力总加成" Binding="{Binding Intelligence, UpdateSourceTrigger=PropertyChanged}" Width="105" />
                  <DataGridTextColumn Header="智力累计范围" Binding="{Binding IntelligenceRange}" IsReadOnly="True" Width="105" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
          <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <StackPanel Margin="4,0,4,8">
                <TextBlock Text="选中职业的天赋 / 技能等级加成" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="LordTalentRuleText" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap" />
              </StackPanel>
              <DataGrid Grid.Row="1" x:Name="LordTalentsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                    EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="天赋 ID" Binding="{Binding TalentId}" IsReadOnly="True" Width="100" />
                  <DataGridTextColumn Header="类型" Binding="{Binding Kind}" IsReadOnly="True" Width="110" />
                  <DataGridTextColumn Header="名称" Binding="{Binding Name}" IsReadOnly="True" Width="*" MinWidth="260" />
                  <DataGridTextColumn Header="等级加成（0=无）" Binding="{Binding Level, UpdateSourceTrigger=PropertyChanged}" Width="170" />
                  <DataGridTextColumn Header="当前上限" Binding="{Binding MaximumLevel}" IsReadOnly="True" Width="110" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
          <Button Grid.Row="3" Content="应用崇拜者及已修改的职业魔偶" Click="ApplyLordButton_Click" Height="36" FontSize="16"/>
        </Grid>
      </TabItem>

      <TabItem Header="角色编辑器">
        <Grid Cursor="Hand">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Card}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="角色" />
                <ComboBox Grid.Column="1" Grid.ColumnSpan="3" x:Name="HeroCombo" DisplayMemberPath="Display" SelectionChanged="HeroCombo_SelectionChanged" />
                <Label Grid.Row="1" Content="名称" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="HeroNameText" />
                <Label Grid.Row="1" Grid.Column="2" Content="等级（读取游戏上限）" />
                <TextBox Grid.Row="1" Grid.Column="3" x:Name="HeroLevelText" />
                <Label Grid.Row="2" Content="力量（STR）" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="StrengthText" />
                <Label Grid.Row="2" Grid.Column="2" Content="敏捷（DEX）" />
                <TextBox Grid.Row="2" Grid.Column="3" x:Name="DexterityText" />
                <Label Grid.Row="3" Content="智力（INT）" />
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="IntelligenceText" />
                <Label Grid.Row="3" Grid.Column="2" Content="剩余技能点" />
                <TextBox Grid.Row="3" Grid.Column="3" x:Name="RemainingPointsText" />
                <Label Grid.Row="4" Content="赐福等级"/>
                <ComboBox Grid.Row="4" Grid.Column="1" x:Name="BlessingLevelCombo" ToolTip="合法等级读取自当前游戏；0 表示清除赐福。"/>
                <Label Grid.Row="4" Grid.Column="2" Content="角色品级"/>
                <ComboBox Grid.Row="4" Grid.Column="3" x:Name="HeroQualityCombo" DisplayMemberPath="Display" ToolTip="调用游戏原生扭曲核心并重算属性"/>
                <Button Grid.Row="5" Grid.ColumnSpan="4" Content="应用品级并重算" Click="ChangeHeroQualityButton_Click" Padding="14,5"
                      ToolTip="单独应用品级；游戏会重新生成该品级的基础属性和每级成长，并同步技能点。" />
              </Grid>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Card}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="120" />
                </Grid.RowDefinitions>
                <Grid>
                  <StackPanel>
                    <TextBlock Text="每级属性成长" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="GrowthRuleText" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
                <DataGrid Grid.Row="1" x:Name="GrowthGrid" AutoGenerateColumns="False" CanUserAddRows="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="属性" Binding="{Binding DisplayName}" IsReadOnly="True" Width="*" />
                    <DataGridTextColumn Header="点数范围" Binding="{Binding PointRange}" IsReadOnly="True" Width="150" />
                    <DataGridTextColumn Header="点数（可编辑）" Binding="{Binding Points, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                    <DataGridTextColumn Header="成长范围" Binding="{Binding ValueRange}" IsReadOnly="True" Width="150" />
                    <DataGridTextColumn Header="成长（可编辑）" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Card}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                  <TextBlock Text="技能树、异化技能与启迪天赋" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock x:Name="ExtraTalentRuleText" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <DataGrid Grid.Row="1" x:Name="TalentsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                    EnableRowVirtualization="False" EnableColumnVirtualization="False">
                  <DataGrid.GroupStyle>
                    <GroupStyle>
                      <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                          <Border Background="#1E293B" BorderBrush="#475569" BorderThickness="0,1,0,1" Padding="10,6" Margin="0,6,0,2">
                            <TextBlock Text="{Binding Name}" Foreground="#E2E8F0" FontWeight="SemiBold" />
                          </Border>
                        </DataTemplate>
                      </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                  </DataGrid.GroupStyle>
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="位置" Binding="{Binding SlotId}" IsReadOnly="True" Width="Auto" MinWidth="85" />
                    <DataGridTemplateColumn Header="来源标识" Width="Auto" MinWidth="125">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="Background" Value="#334155" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Kind}" Value="基础技能">
                                    <Setter Property="Background" Value="#475569" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Kind}" Value="天赋技能">
                                    <Setter Property="Background" Value="#1D4ED8" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Kind}" Value="天赋专精">
                                    <Setter Property="Background" Value="#047857" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding IsAlien}" Value="True">
                                    <Setter Property="Background" Value="#7C3AED" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding IsInspired}" Value="True">
                                    <Setter Property="Background" Value="#B45309" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Kind}" Foreground="White" FontWeight="SemiBold" />
                          </Border>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="技能 / 天赋（天赋技能可更换）" Width="*" MinWidth="420">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <ComboBox ItemsSource="{Binding SkillOptions}" DisplayMemberPath="Display" SelectedValuePath="TalentId"
                              IsEnabled="{Binding CanChangeTalent}"
                              SelectedValue="{Binding TalentId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectionChanged="SkillOption_SelectionChanged" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="合法范围" Binding="{Binding LevelRange}" IsReadOnly="True" Width="Auto" MinWidth="115" />
                    <DataGridTextColumn Header="等级（可编辑）" Binding="{Binding Level, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="140" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </Border>
          </Grid>
          <Button Grid.Row="1" Content="应用角色、每级属性成长和技能树修改" Click="ApplyHeroButton_Click" Height="36" FontSize="16"/>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
